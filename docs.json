            ]
          },
          {
            "group": "Pricing",
            "pages": [
              "pricing/overview"
            ]
          },
          {
            "group": "Security & Compliance",
            "pages": [
              "security/overview"
            ]
          },
          {
            "group": "Resources",
            "pages": [
              "resources/index"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "icon": "square-terminal",
        "groups": [
          {
            "group": "API Reference",
            "pages": [
              "api-reference/overview"
            ]
          }
        ]
      },
      {
        "tab": "Changelog",
        "icon": "history",
        "groups": [
          {
            "group": "Changelog",
            "pages": [
              "changelog/index"
            ]
          }
        ]
      },
      {
        "tab": "Research",
        "icon": "flask-conical",
        "groups": [
          {
            "group": "Research",
            "pages": [
              "research/index"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/amlok-logo-blue.svg",
